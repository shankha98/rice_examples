{
    "name": "slate-client",
    "version": "1.0.0",
    "description": "Node.js/TypeScript Client for Slate",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc && mkdir -p dist/proto && cp src/proto/slate.proto dist/proto/slate.proto",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@grpc/grpc-js": "^1.9.0",
        "@grpc/proto-loader": "^0.7.0"
    },
    "devDependencies": {
        "@google/generative-ai": "^0.24.1",
        "@types/node": "^20.0.0",
        "dotenv": "^17.2.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0"
    }
}